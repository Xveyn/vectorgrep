{
  "name": "@xveyn/codebase-semantic-search",
  "version": "0.1.0",
  "description": "MCP Server for vector-based semantic code search in Claude Code. Index your codebase locally with LanceDB and search code, files, and symbols using natural language.",
  "keywords": [
    "mcp",
    "claude-code",
    "semantic-search",
    "vector-database",
    "lancedb",
    "embeddings",
    "code-search"
  ],
  "license": "MIT",
  "author": "Xveyn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xveyn/codebase-semantic-search.git"
  },
  "homepage": "https://github.com/Xveyn/codebase-semantic-search#readme",
  "bugs": {
    "url": "https://github.com/Xveyn/codebase-semantic-search/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "codebase-semantic-search": "build/index.js"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "^0.15.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "apache-arrow": "^18.1.0",
    "chokidar": "^5.0.0",
    "glob": "^13.0.6",
    "simple-git": "^3.27.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1"
  }
}
